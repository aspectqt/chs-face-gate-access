# MongoDB
MONGODB_URI=mongodb://localhost:27017/face_gate_db
MONGODB_DB_NAME=face_gate_db

# PHILSMS (Token mode - preferred)
PHILSMS_BASE_URL=https://app.philsms.com/api/v3
PHILSMS_API_TOKEN=your_philsms_api_token_here
PHILSMS_SENDER_ID=PhilSMS
PHILSMS_SEND_PATH=/sms/send
PHILSMS_MESSAGE_TYPE=plain
PHILSMS_USER_AGENT=CHSGateAccess/1.0
PHILSMS_TIMEOUT_SECONDS=10
PHILSMS_MAX_RETRIES=3
PHILSMS_BACKOFF_SECONDS=0.6
PHILSMS_BALANCE_PATH=/balance

# SMS balance monitoring
SMS_BALANCE_CACHE_TTL_SECONDS=60
SMS_BALANCE_LOW_THRESHOLD=50

# PHILSMS (OAuth mode - optional alternative)
# PHILSMS_CLIENT_ID=
# PHILSMS_CLIENT_SECRET=
# PHILSMS_TOKEN_URL=https://app.philsms.com/api/v3/oauth/token
# PHILSMS_REFRESH_TOKEN=

# OTP
OTP_CODE_LENGTH=6
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_THROTTLE_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_MESSAGE_TEMPLATE=Your CHS Gate Access OTP is {code}. It expires in {minutes} minutes.

# Gate scan cooldown (seconds, min 5)
SCAN_COOLDOWN_SECONDS=8
SCAN_FRAME_WIDTH=640
SCAN_FRAME_HEIGHT=480
SCAN_TARGET_FPS=20
SCAN_PROCESS_EVERY_N_FRAMES=2
SCAN_RECOGNITION_INTERVAL_MS=120
SCAN_RECOGNITION_SCALE_PERCENT=50
SCAN_JPEG_QUALITY=80
SCAN_CAPTURE_FLUSH_GRABS=2
SCAN_FORCE_RESIZE=1
SCAN_FACE_INDEX_ALLOW_LEGACY_IMAGE_FALLBACK=0

# Development server auto-reload (set to 1 while developing)
FLASK_DEBUG=1
FLASK_SECRET_KEY=replace_with_a_long_random_secret_key
# HTTPS is required for camera access on non-localhost devices
HTTPS_ENABLED=1
FORCE_HTTPS=1
TRUST_PROXY_HEADERS=0
FLASK_HOST=0.0.0.0
FLASK_PORT=5444
SSL_CERT_FILE=
SSL_KEY_FILE=
SESSION_COOKIE_SECURE=1

# Security headers
ENABLE_SECURITY_HEADERS=1
# Set to 1 to enforce CSP; keep 0 in development to use Report-Only mode.
CSP_ENFORCE=0

# Debug route fallback recipient
TEST_SMS_RECIPIENT=+639171234567

# Email SMTP (Forgot Password)
# Gmail example:
# 1) Enable 2-Step Verification on your Google account
# 2) Create an App Password and use it below (not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address_here@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password_here
SMTP_FROM=your_gmail_address_here@gmail.com
SMTP_USE_TLS=1
SMTP_USE_SSL=0

# Public base URL used when generating password reset links
# Local dev example:
APP_BASE_URL=https://127.0.0.1:5444

# Password reset rate limit (set 0 for local testing only)
PASSWORD_RESET_RATE_LIMIT_ENABLED=1
PASSWORD_RESET_REQUEST_WINDOW_MINUTES=15
PASSWORD_RESET_MAX_REQUESTS_PER_WINDOW=3
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Login hardening
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Background jobs (Scheduled Reports + Anomaly Rules)
ENABLE_BACKGROUND_JOBS=1
BACKGROUND_JOB_INTERVAL_SECONDS=60
ANOMALY_DEFAULT_COOLDOWN_MINUTES=60

# Keep disabled in production so SMTP failures are shown as errors
PASSWORD_RESET_DEV_LINK_FALLBACK=0
